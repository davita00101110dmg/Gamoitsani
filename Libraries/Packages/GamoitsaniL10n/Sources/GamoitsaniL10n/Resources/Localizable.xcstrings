    "challenge.handOnHead" : {
      "extractionState" : "manual",
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sözləri izah edən oyunçu həmişə bir əlini başında saxlamalıdır."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Spieler, der die Wörter erklärt, muss immer eine Hand auf dem Kopf behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The player explaining the words must always keep one hand on their head."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El jugador que explica las palabras debe mantener siempre una mano en su cabeza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le joueur qui explique les mots doit toujours garder une main sur sa tête."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Բառերը բացատրող խաղացողը միշտ պետք է մեկ ձեռքը գլխին պահի:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語を説明するプレイヤーは、常に片手を頭に置いておかなければなりません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მოთამაშემ, რომელიც ხსნის სიტყვებს, მუდამ ერთი ხელი თავზე უნდა ჰქონდეს."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игрок, объясняющий слова, должен всегда держать одну руку на голове."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelimeleri açıklayan oyuncu, her zaman bir elini kafasında tutmalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гравець, який пояснює слова, завжди повинен тримати одну руку на голові."
          }
        }
      }
    },
