        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გუნდის ყველა წევრმა უნდა იჩურჩულოს მთელი რაუნდის განმავლობაში."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все члены команды должны шептать на протяжении всего раунда."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm takım üyeleri, tüm tur boyunca fısıldamalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всі члени команди повинні шепотіти протягом усього раунду."
          }
