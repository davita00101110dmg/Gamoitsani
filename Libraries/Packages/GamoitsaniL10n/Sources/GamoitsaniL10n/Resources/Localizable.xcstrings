    "challenge.questionForm" : {
      "extractionState" : "manual",
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Təxmin edən 'Bu [söz] dir?' formasında cavab verməlidir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ratende muss in der Form antworten: 'Ist es [Wort]?'"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The guesser must answer in the form of: 'Is it [word]?'"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El que adivina debe responder en la forma: '¿Es [palabra]?'"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le devin doit répondre sous la forme : 'Est-ce [mot] ?'"
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Գուշակողը պետք է պատասխանի հետևյալ ձևով. 'Դա [բառ] է?':"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推測する人は「それは[単語]ですか？」という形式で答えなければなりません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გამომცნობმა უნდა უპასუხოს შემდეგი ფორმით: 'ეს არის [სიტყვა]?'"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отгадывающий должен отвечать в форме: 'Это [слово]?'"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahmin eden, 'Bu [kelime] mi?' şeklinde cevap vermelidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Той, хто вгадує, має відповідати у формі: 'Це [слово]?'"
          }
        }
      }
    },
    "challenge.robotVoice" : {
      "extractionState" : "manual",
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzah edən oyunçu bütün raund ərzində robot səsi ilə danışmalıdır."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der erklärende Spieler muss während der ganzen Runde mit Roboterstimme sprechen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The explaining player must speak in a robot voice throughout the round."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El jugador que explica debe hablar con voz de robot durante toda la ronda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le joueur qui explique doit parler avec une voix de robot tout au long de la manche."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Բացատրող խաղացողը պետք է խոսի ռոբոտի ձայնով ողջ փուլի ընթացքում:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "説明するプレイヤーはラウンド中、ロボットの声で話さなければなりません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ამხსნელმა მოთამაშემ უნდა ისაუბროს რობოტის ხმით მთელი რაუნდის განმავლობაში."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объясняющий игрок должен говорить голосом робота на протяжении всего раунда."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açıklayan oyuncu, tur boyunca robot sesiyle konuşmalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гравець, який пояснює, повинен говорити голосом робота протягом усього раунду."
          }
        }
      }
    },
    "challenge.royalTitles" : {
      "extractionState" : "manual",
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komanda üzvləri bir-birinə kral titullarından istifadə edərək müraciət etməlidir (Əlahəzrət)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teammitglieder müssen sich gegenseitig mit königlichen Titeln ansprechen (Eure Majestät)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Team members must address each other using royal titles (Your Majesty)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los miembros del equipo deben dirigirse entre sí usando títulos reales (Su Majestad)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les membres de l'équipe doivent s'adresser les uns aux autres en utilisant des titres royaux (Votre Majesté)."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Թիմի անդամները պետք է դիմեն միմյանց՝ օգտագործելով արքայական տիտղոսներ (Ձերդ Մեծություն):"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チームメンバーは互いに王族の敬称（陛下）を使って呼びかけなければなりません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გუნდის წევრებმა უნდა მიმართონ ერთმანეთს სამეფო ტიტულების გამოყენებით (თქვენო უდიდებულესობავ)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Члены команды должны обращаться друг к другу, используя королевские титулы (Ваше Величество)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takım üyeleri birbirlerine kraliyet unvanları kullanarak hitap etmelidir (Majesteleri)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Члени команди повинні звертатися один до одного, використовуючи королівські титули (Ваша Величносте)."
          }
        }
      }
    },
