# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## macOS
.DS_Store

## Configuration file
#
# Contains ad unit IDs, Firestore collection names and SDK secrets, so it is not
# committed. Copy the template and fill in real values — see docs/SETUP.md:
#   cp Gamoitsani/Resources/Configuration/Config.xcconfig.template \
#      Gamoitsani/Resources/Configuration/Config.xcconfig
Config.xcconfig
!Config.xcconfig.template

## Generated Firestore rules
#
# firestore.rules is generated from firestore.rules.template by
# ./scripts/generate-firestore-rules.sh, substituting the collection names held in
# Config.xcconfig. Only the template is committed. Deploy the generated file.
firestore.rules
!firestore.rules.template
firestore-debug.log

## User settings
xcuserdata/

## compatibility with Xcode 8 and earlier (ignoring not required starting Xcode 9)
*.xcscmblueprint
*.xccheckout

## compatibility with Xcode 3 and earlier (ignoring not required starting Xcode 4)
build/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

## Obj-C/Swift specific
*.hmap

## Merge/backup artifacts
#
# Removing the old `*.xcodeproj` rule made these visible. There is a stale
# `Gamoitsani.xcodeproj/project.pbxproj.orig` from Oct 2025 in the working tree — it is
# untracked and safe to delete by hand.
*.orig
*.rej

## Xcode performance-test baselines
#
# Machine-specific: these record the CPU of whoever ran the benchmark, so committing them
# just creates cross-machine noise.
xcbaselines/

## App packaging
*.ipa
*.dSYM.zip
*.dSYM

## Playgrounds
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
#
# NOTE: `Gamoitsani.xcodeproj` and `Gamoitsani.xcworkspace` are REQUIRED to build and are
# deliberately tracked — do not add `*.xcodeproj` / `*.xcworkspace` ignore rules here.
#
# NOTE: `Package.resolved` is tracked on purpose so dependency versions are reproducible.
#
# `/Packages` is anchored to the repo root: it ignores SPM's legacy checkout directory
# without swallowing our local package at `Libraries/Packages/GamoitsaniMacros`.
/Packages/
Package.pins
#
# Xcode automatically generates this directory with a .xcworkspacedata file and xcuserdata
# hence it is not needed unless you have added a package configuration file to your project
.swiftpm

.build/

# CocoaPods
#
# `Pods/` is generated by `pod install` — run it after cloning (see docs/SETUP.md).
# `Podfile.lock` IS tracked so everyone resolves the same pod versions.
Pods/

# Carthage
#
# Add this line if you want to avoid checking in source code from Carthage dependencies.
Carthage/Checkouts
Carthage/Build/

# Accio dependency management
Dependencies/
.accio/

# fastlane
#
# It is recommended to not store the screenshots in the git repo.
# Instead, use fastlane to re-generate the screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/#source-control

fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Code Injection
#
# After new code Injection tools there's a generated folder /iOSInjectionProject
# https://github.com/johnno1962/injectionforxcode

iOSInjectionProject/
